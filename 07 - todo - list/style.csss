* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    min-height: 100vh;

    display: flex;
    justify-content: center;
    align-items: center;

    padding: 20px;

    font-family: Arial, sans-serif;

    background: #f1f5f9;
    color: #172033;
}

.container {
    width: 100%;
    max-width: 600px;
}

.todo-card {
    padding: 35px;

    background: white;

    border-radius: 20px;

    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.1);
}

h1 {
    font-size: 32px;
}

.subtitle {
    margin-top: 8px;
    margin-bottom: 25px;

    color: #64748b;
}

#todoForm {
    display: flex;
    gap: 10px;
}

#taskInput {
    flex: 1;

    padding: 14px;

    border: 1px solid #cbd5e1;
    border-radius: 8px;

    font-size: 16px;

    outline: none;
}

#taskInput:focus {
    border-color: #2563eb;
}

#todoForm button {
    padding: 0 22px;

    border: none;
    border-radius: 8px;

    background: #2563eb;
    color: white;

    font-size: 16px;
    font-weight: bold;

    cursor: pointer;
}

.task-info {
    margin: 25px 0 15px;

    display: flex;
    justify-content: space-between;
    align-items: center;

    color: #64748b;
}

#clearButton {
    border: none;

    background: transparent;

    color: #dc2626;

    cursor: pointer;

    font-weight: bold;
}

#taskList {
    list-style: none;
}

.task {
    display: flex;
    align-items: center;
    gap: 12px;

    padding: 14px;

    margin-bottom: 10px;

    background: #f8fafc;

    border: 1px solid #e2e8f0;

    border-radius: 10px;
}

.task-checkbox {
    width: 18px;
    height: 18px;

    cursor: pointer;
}

.task-text {
    flex: 1;

    word-break: break-word;
}

.task.completed .task-text {
    text-decoration: line-through;

    color: #94a3b8;
}

.delete-button {
    border: none;

    background: transparent;

    color: #dc2626;

    font-size: 18px;

    cursor: pointer;
}

#emptyMessage {
    padding: 20px 0;

    text-align: center;

    color: #94a3b8;
}

@media (max-width: 500px) {

    .todo-card {
        padding: 25px 18px;
    }

    #todoForm {
        flex-direction: column;
    }

    #todoForm button {
        padding: 13px;
    }
}